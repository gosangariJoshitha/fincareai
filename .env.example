# ============================================================
# FinCare AI — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it contains secrets.
# ============================================================

# Flask & JWT
SECRET_KEY=your-flask-secret-key-change-this
JWT_SECRET=your-jwt-secret-key-change-this

# Groq LLM (Get your key from: https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# Email / SMTP
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-support-email@gmail.com
SMTP_PASSWORD=your-app-password

# Jira Integration
JIRA_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-email@gmail.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=BANK
JIRA_SIMULATION_MODE=true

# Escalation threshold
AUTO_RESOLVE_THRESHOLD=70.0
